UDMP_HOST=192.168.1.1
UDMP_API_KEY=

# Legacy session API (wlans/firewall/networks/ports/known-clients) —
# dedicated read-only local admin account, not your personal login
UDMP_UI_USERNAME=
UDMP_UI_PASSWORD=

# UniFi Protect (protect-status) — separate host if the NVR is a
# standalone appliance, not the same console as the gateway
UDMP_PROTECT_HOST=
UDMP_PROTECT_API_KEY=
